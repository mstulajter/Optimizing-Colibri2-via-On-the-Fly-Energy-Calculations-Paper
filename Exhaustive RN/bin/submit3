#!/bin/sh

PORT_SQL=$1
PORT_REDIS=$2
SET_FILE=$3
INPUT_FILE=$4

# Executable file location. Change 'path' to the colibri2 top installation directory.
EXECUTABLE=/app/colibri2/cli/submit3cli.py

# PostgreSQL database url. Default for a PostgreSQL server is postgres:postgres@localhost:5432/postgres
DB_URL=postgresql+psycopg2://colibri2:Stulajter@localhost:$PORT_SQL/colibri2

# Redis server location. Set to defaults for a local installation
QUEUE_URL=redis://@localhost:$PORT_REDIS/0

# Table names
FORMULA_TABLE=formulas
GEOMETRY_TABLE=geometries
PROPERTY_TABLE=properties
FAILED_FORMULA_TABLE=failed_formulas
FAILED_CONFIGURATION_TABLE=failed_configurations
FAILED_GEOMETRY_TABLE=failed_geometries
FAILED_PROPERTY_TABLE=failed_properties
INVALID_CONFIGURATION_TABLE=invalid_configurations
INVALID_GEOMETRY_TABLE=invalid_geometries
INVALID_PROPERTY_TABLE=invalid_properties
MOLECULE_QUEUE=queue_formulas
PROPERTY="energy"

export COLIB2_LOGGING__LEVEL=CRITICAL

# Clear data
CLEAR_DATA="-C"

# Append
APPEND="-A"

# Unique
UNIQUE="-U"

# Compute properties
PROPERTY=""

if [ -z "$4" ]; then
  echo "Usage: submit3 <input file>"
  exit 1
fi

COMMAND=`echo python3 $EXECUTABLE -i "$INPUT_FILE" "$CLEAR_DATA" "$APPEND" "$UNIQUE" \
   -d "$DB_URL" -q "$QUEUE_URL" -f "$FORMULA_TABLE" -g "$GEOMETRY_TABLE" -y "$PROPERTY_TABLE" \
   -F "$FAILED_FORMULA_TABLE" -X "$FAILED_CONFIGURATION_TABLE" -G "$FAILED_GEOMETRY_TABLE" \
   -l "$FAILED_PROPERTY_TABLE" -I "$INVALID_CONFIGURATION_TABLE" -Y "$INVALID_GEOMETRY_TABLE" \
   -L "$INVALID_PROPERTY_TABLE" -m "$MOLECULE_QUEUE" "$PROPERTY" -Z "$SET_FILE"`

echo $COMMAND
sh -c "$COMMAND"
