#!/bin/sh
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
. "$SCRIPT_DIR/env.params5"
EXECUTABLE="/app/colibri2/cli/initialize5cli.py"

COMMAND=`echo python3 $EXECUTABLE -i \""$INITIAL_FLASK\"" -d "$DB_URL" -c "$CACHE_URL" -q "$QUEUE_URL" -h "$REGISTRY_URL" \
  -f "$FLASK_TABLE" -I "$INVALID_TABLE" -t "$TRANS_TABLE" -r "$RULE_TABLE" -F "$FLASK_TRANS_QUEUE" \
  -T "$MOLECULE_QUEUE" -E "$FORMULA_ENERGY_CACHE" -R "$RUNNING_GEOMETRY_REGISTRY" -V "$EQUIVALENCE_MOLECULE_QUEUE" \
  -C "$FLASK_CACHE" -v "$EQUIVALENCE_FORMULA_CACHE" -J "$PENDING_FLASK_REGISTRY" -Z "$SET_FILE"`
echo $COMMAND
sh -c "$COMMAND"

