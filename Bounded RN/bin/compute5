#!/bin/sh
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
. "$SCRIPT_DIR/env.params5"
EXECUTABLE="/app/colibri2/cli/compute5cli.py"

COMMAND=`echo python3 $EXECUTABLE -c "$CACHE_URL" -q "$QUEUE_URL" -h "$REGISTRY_URL" \
  -F "$FLASK_TRANS_QUEUE" -C "$FLASK_CACHE" -E "$FORMULA_ENERGY_CACHE" -T "$MOLECULE_QUEUE" \
  -R "$RUNNING_GEOMETRY_REGISTRY" -V "$EQUIVALENCE_MOLECULE_QUEUE" -v "$EQUIVALENCE_FORMULA_CACHE" \
  -J "$PENDING_FLASK_REGISTRY" -N "$NETWORK_RUNNING_REGISTRY" -k "$GEOMETRY_OPTIMIZER" -X "$GEOMETRY_EXECUTABLE" \
  -Z "$SET_FILE"`
echo $COMMAND
sh -c "$COMMAND"
