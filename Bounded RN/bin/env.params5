# Parameters for the 5-command group: initialize5, compute5, network5, export5.
# Source from each script: . "$SCRIPT_DIR/env.params5"

INITIAL_FLASK=XX
PORT_SQL=XX
PORT_REDIS=XX
SET_FILE=XX
RULES_FILE=XX
EQUIV_FILE=XX
ENERGY_THRESHOLD=XX
MAX_GENERATIONS=XX

# Connection
DB_URL=postgresql+psycopg2://colibri2:Stulajter@localhost:$PORT_SQL/colibri2
CACHE_URL=redis://@localhost:$PORT_REDIS/0
QUEUE_URL=redis://@localhost:$PORT_REDIS/0
REGISTRY_URL=redis://@localhost:$PORT_REDIS/0

# Database tables
FLASK_TABLE=superformulas
INVALID_TABLE=invalid_superformulas
TRANS_TABLE=transformations
RULE_TABLE=rules

# Redis queues
FLASK_TRANS_QUEUE=flask_transformations
MOLECULE_QUEUE=geometries
EQUIVALENCE_MOLECULE_QUEUE=equivalence_geometries

# Redis caches
FLASK_CACHE=cache_superformulas
FORMULA_ENERGY_CACHE=cache_formulas
EQUIVALENCE_FORMULA_CACHE=cache_equivalence_formulas

# Redis registries
RUNNING_GEOMETRY_REGISTRY=running_geometries
PENDING_FLASK_REGISTRY=pending_flasks
NETWORK_RUNNING_REGISTRY=running_calculations

# Geometry / property (for compute5 and proton precalc in initialize5)
GEOMETRY_OPTIMIZER=MOPAC
GEOMETRY_EXECUTABLE="/opt/conda/envs/colibri2/bin/mopac"

# Network5 rules path
RULES_FILE=$RULES_FILE

# Equivalence5 rules path
EQUIVALENCE_FILE=$EQUIV_FILE

# Config (COLIB2_*)
export COLIB2_CONFIGURATION__FF_OPTIMIZATION=true
export COLIB2_CONFIGURATION__FF_METHOD="UFF"
export COLIB2_CONFIGURATION__FF_ITERATIONS=3000
export COLIB2_CONFIGURATION__METHOD="ETDG/UFF"
export COLIB2_GEOMETRY__PROGRAM="mopac"
export COLIB2_GEOMETRY__VERSION="23.2.2"
export COLIB2_GEOMETRY__METHOD="pm7"
export COLIB2_GEOMETRY__ITERATIONS=1000
export COLIB2_GEOMETRY__OPTIONS="precise gnorm=0.0 scfcrt=1.d-9 eps=78.4"
export COLIB2_GEOMETRY__EXECUTABLE="$GEOMETRY_EXECUTABLE"
export COLIB2_COMPUTE5__OPTIMIZER="$GEOMETRY_OPTIMIZER"
export COLIB2_COMPUTE5__EMPTY_TASKS_TO_STOP=3
export COLIB2_LOGGING__LEVEL=CRITICAL
export OMP_NUM_THREADS=4
case "$ENERGY_THRESHOLD" in I) ENERGY_THRESHOLD="" ;; esac
case "$MAX_GENERATIONS" in I) MAX_GENERATIONS="" ;; esac
export COLIB2_NETWORK5__MAX_ABS_ENERGY_DIFF="$ENERGY_THRESHOLD"
export COLIB2_NETWORK5__MAX_GENERATIONS="$MAX_GENERATIONS"

